[Icon Theme]
Name=Lindle
Comment=Lindle's icons: Colloid with Lindle's logo and launcher on top
Inherits=Colloid-Light,breeze,hicolor
Example=folder

DesktopDefault=48
DesktopSizes=16,22,32,48,64,96,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
