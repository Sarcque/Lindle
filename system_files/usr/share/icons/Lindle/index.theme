[Icon Theme]
Name=Lindle
Comment=Lindle's icon theme: rounded tiles and soft blue folders, on top of Breeze
Inherits=breeze,hicolor
Example=folder
FollowsColorScheme=false
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32
MainToolbarDefault=22
MainToolbarSizes=16,22,32
SmallDefault=16
SmallSizes=16
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256

Directories=scalable/apps,scalable/places,scalable/mimetypes

[scalable/apps]
Size=128
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[scalable/places]
Size=128
MinSize=16
MaxSize=512
Context=Places
Type=Scalable

[scalable/mimetypes]
Size=128
MinSize=16
MaxSize=512
Context=MimeTypes
Type=Scalable
