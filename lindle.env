# Build parameters for the Lindle image

# Output image name (same as the repo name, lowercase)
IMAGE_NAME=lindle

# GitHub user or organisation that owns the repo (lowercase, used for ghcr.io)
REPO_ORGANIZATION="sarcque"

IMAGE_DESC="Lindle: a modern, open source desktop for people coming from macOS and Windows"
IMAGE_KEYWORDS="bootc,oci,linux,kde,desktop,lindle"

IMAGE_LOGO_URL="https://raw.githubusercontent.com/sarcque/lindle/main/design/logo/lindle-mark.svg"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
